#!/bin/bash
#
# Backup Script for Powerwall Dashboard Data
#   https://github.com/jasonacox/Powerwall-Dashboard
#   by Jason Cox - 27 Feb 2022
#
# Creates a consistent, restorable archive (see restore.sh) containing:
#   influxdb/   InfluxDB portable snapshot (influxd backup -portable)
#   grafana/    grafana.db (sqlite3 online backup) + provisions/
#   config/     configuration files (*.env, *.conf, *.yml, telegraf.local, ...)
#   weather/    weather411.conf (if present)
#   auth/       .auth/ Tesla cloud tokens (if present)
#
# Usage:
#   sudo ./backup.sh
#
# Notes:
#   - Keep this script in Powerwall-Dashboard/backups/ (location is
#     auto-detected from the script's own path).
#   - The influxdb container must be running (the snapshot is taken online -
#     no downtime).
#   - Archives contain credentials (.env files, Tesla tokens). They are
#     created with mode 600 - keep them protected.
#   - Data is staged under mktemp -d (usually /tmp). For large datasets,
#     point staging at a disk with more space:
#       sudo TMPDIR=/path/with/space ./backup.sh
#   - Cron example (daily at 2am):
#       0 2 * * * /home/user/Powerwall-Dashboard/backups/backup.sh
#     The default stamp includes the hour so multiple runs per day
#     don't overwrite each other. For finer granularity, add minutes:
#       STAMP=$(date '+%Y-%m-%d_%H-%M')

set -o pipefail

KEEP="5"    # Days of backup archives to keep

die() { echo "ERROR: $*" >&2; exit 1; }

# ── Preflight checks ──────────────────────────────────────────────────
[ "$EUID" -eq 0 ] || die "Must run as root (sudo ./backup.sh)"

# Locate the Powerwall-Dashboard directory relative to this script.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DASHBOARD="$(dirname "${SCRIPT_DIR}")"
[ -f "${DASHBOARD}/compose-dash.sh" ] \
  || die "Could not locate Powerwall-Dashboard (no compose-dash.sh in ${DASHBOARD}).
Place this script in your Powerwall-Dashboard/backups/ directory."

BACKUP_FOLDER="${DASHBOARD}/backups"
[ -d "${BACKUP_FOLDER}" ] || die "Backup directory ${BACKUP_FOLDER} does not exist."

echo "Using Powerwall-Dashboard directory: ${DASHBOARD}"

# The snapshot is taken online - influxdb must be up.
[ "$(docker inspect -f '{{.State.Running}}' influxdb 2>/dev/null)" = "true" ] \
  || die "The influxdb container is not running. Start the stack first: ./compose-dash.sh up -d"

# Pre-flight disk space on the DASHBOARD filesystem: influxd backup writes
# its snapshot into ${DASHBOARD}/influxdb/backups before anything is staged.
# The snapshot (gzip-compressed shards) is normally smaller than the data
# directory, so the data directory size is a safe upper-bound estimate.
DATA_KB=$(du -sk "${DASHBOARD}/influxdb/data" 2>/dev/null | cut -f1)
DASH_AVAIL_KB=$(df -Pk "${DASHBOARD}" | awk 'NR==2 {print $4}')
if [ -n "${DATA_KB}" ] && [ -n "${DASH_AVAIL_KB}" ] && [ "${DASH_AVAIL_KB}" -lt "${DATA_KB}" ]; then
  die "Not enough free space on the dashboard disk for the InfluxDB snapshot.
  Estimated needed: $((DATA_KB / 1024)) MB (size of influxdb/data)
  Available:        $((DASH_AVAIL_KB / 1024)) MB
Free up space before backing up."
fi

# ── Staging ───────────────────────────────────────────────────────────
STAMP=$(date '+%Y-%m-%d_%H')
STAGING=$(mktemp -d)
trap 'rm -rf "${STAGING}"' EXIT

ARCHIVE="${BACKUP_FOLDER}/Powerwall-Dashboard.${STAMP}.tar.xz"

echo "========================================="
echo " Powerwall-Dashboard Backup - ${STAMP}"
echo "========================================="

# ── 1. InfluxDB snapshot ──────────────────────────────────────────────
# influxd backup creates a consistent online snapshot (no downtime, no
# "file changed as we read it" risk). The -portable flag makes it
# self-contained and restorable on any InfluxDB 1.x instance.
echo ""
echo "[1/5] Creating InfluxDB snapshot..."
cd "${DASHBOARD}" || die "Cannot cd to ${DASHBOARD}"
mkdir -p influxdb/backups
chmod g+w influxdb/backups
rm -rf influxdb/backups/*    # clear stale snapshots from earlier runs

docker exec influxdb influxd backup -portable -database powerwall /var/lib/influxdb/backups \
  || { rm -rf influxdb/backups/*; die "influxd backup failed - no archive created."; }

# Staging disk space: now that the snapshot exists we know its exact size.
# Abort (cron-safe - no prompt) rather than fill a RAM-backed /tmp.
SNAPSHOT_KB=$(du -sk influxdb/backups | cut -f1)
STAGING_AVAIL_KB=$(df -Pk "${STAGING}" | awk 'NR==2 {print $4}')
if [ -n "${STAGING_AVAIL_KB}" ] && [ "${STAGING_AVAIL_KB}" -lt "$((SNAPSHOT_KB + SNAPSHOT_KB / 10))" ]; then
  rm -rf influxdb/backups/*
  die "Staging area ${STAGING} cannot hold the snapshot.
  Snapshot size: $((SNAPSHOT_KB / 1024)) MB
  Available:     $((STAGING_AVAIL_KB / 1024)) MB
If /tmp is a RAM-backed tmpfs, staging there can exhaust memory.
Re-run with staging on a disk that has space: sudo TMPDIR=/path/with/space $0"
fi

mkdir -p "${STAGING}/influxdb"
cp -a influxdb/backups/. "${STAGING}/influxdb/"
rm -rf influxdb/backups/*

# Export live continuous queries (including user customizations) as clean
# CREATE statements. influxd restore -portable does not reliably restore
# CQs (known InfluxDB 1.x limitation) - restore.sh replays these.
docker exec influxdb influx -database powerwall \
  -execute "SHOW CONTINUOUS QUERIES" 2>/dev/null \
  | sed -n 's/.*\(CREATE CONTINUOUS QUERY.*\)/\1/p' \
  > "${STAGING}/influxdb/continuous_queries.txt"
echo "  ✓ InfluxDB snapshot captured ($((SNAPSHOT_KB / 1024)) MB)"

# ── 2. Grafana database ───────────────────────────────────────────────
# sqlite3 .backup (SQLite's online backup API) gives a consistent copy of
# a live grafana.db. Falls back to a direct copy if sqlite3 is missing.
echo ""
echo "[2/5] Backing up Grafana database..."
mkdir -p "${STAGING}/grafana"

GRAFANA_DB="${DASHBOARD}/grafana/grafana.db"
if [ -f "${GRAFANA_DB}" ]; then
  if command -v sqlite3 >/dev/null 2>&1; then
    sqlite3 "${GRAFANA_DB}" ".backup '${STAGING}/grafana/grafana.db'"
    echo "  ✓ Grafana DB backed up (consistent copy via sqlite3)"
  else
    cp -a "${GRAFANA_DB}" "${STAGING}/grafana/grafana.db"
    echo "  ⚠ Grafana DB copied directly (for consistent backups: sudo apt install sqlite3)"
  fi
else
  echo "  - No grafana.db found (skipping)"
fi

if [ -d "${DASHBOARD}/grafana/provisions" ]; then
  cp -a "${DASHBOARD}/grafana/provisions" "${STAGING}/grafana/"
fi

# ── 3. Configuration files ────────────────────────────────────────────
echo ""
echo "[3/5] Backing up configuration files..."
mkdir -p "${STAGING}/config"

# Essentials always captured; globs below catch anything additional.
CONFIG_FILES=(
  "compose.env"
  "pypowerwall.env"
  "grafana.env"
  "influxdb.env"
  "influxdb.conf"
  "telegraf.conf"
  "telegraf.local"
  "powerwall.yml"
  "VERSION"
)

FOUND=0
for FILE in "${CONFIG_FILES[@]}"; do
  if [ -f "${DASHBOARD}/${FILE}" ]; then
    cp -a "${DASHBOARD}/${FILE}" "${STAGING}/config/"
    FOUND=$((FOUND + 1))
  fi
done

# Any additional .env, .conf, and .yml/.yaml files at the dashboard root.
for EXTRA in "${DASHBOARD}"/.*.env "${DASHBOARD}"/*.env "${DASHBOARD}"/*.conf "${DASHBOARD}"/*.yml "${DASHBOARD}"/*.yaml; do
  if [ -f "${EXTRA}" ]; then
    BASENAME=$(basename "${EXTRA}")
    if [[ " ${CONFIG_FILES[*]} " != *" ${BASENAME} "* ]]; then
      cp -a "${EXTRA}" "${STAGING}/config/"
      FOUND=$((FOUND + 1))
    fi
  fi
done 2>/dev/null
echo "  ✓ ${FOUND} config file(s) backed up"

# ── 4. Weather service config ─────────────────────────────────────────
echo ""
echo "[4/5] Backing up weather411 config..."
if [ -f "${DASHBOARD}/weather/weather411.conf" ]; then
  mkdir -p "${STAGING}/weather"
  cp -a "${DASHBOARD}/weather/weather411.conf" "${STAGING}/weather/"
  echo "  ✓ weather411.conf backed up"
else
  echo "  - No weather411.conf found (skipping)"
fi

# ── 5. Tesla cloud auth tokens ────────────────────────────────────────
echo ""
echo "[5/5] Backing up .auth (Tesla cloud tokens)..."
if [ -d "${DASHBOARD}/.auth" ] && [ -n "$(ls -A "${DASHBOARD}/.auth" 2>/dev/null)" ]; then
  mkdir -p "${STAGING}/auth"
  cp -a "${DASHBOARD}/.auth/." "${STAGING}/auth/"
  echo "  ✓ .auth backed up"
else
  echo "  - No .auth directory found (skipping)"
fi

# ── Create archive ────────────────────────────────────────────────────
echo ""
echo "Creating backup archive (xz compression — this may take several minutes)..."
cd "${STAGING}" || die "Cannot cd to ${STAGING}"
tar -Jcf "${ARCHIVE}" . || die "Archive creation failed."
chmod 600 "${ARCHIVE}"    # contains credentials - restrict access

# Verify the archive is readable before trusting it.
tar -tJf "${ARCHIVE}" > /dev/null || die "Archive verification failed: ${ARCHIVE}"

# ── Prune old backups ─────────────────────────────────────────────────
echo "Cleaning up backups older than ${KEEP} days..."
find "${BACKUP_FOLDER}" -name "Powerwall-Dashboard.*.tar.xz" -mtime +"${KEEP}" -type f -delete

ARCHIVE_KB=$(du -k "${ARCHIVE}" | cut -f1)
echo ""
echo "========================================="
echo " Backup complete!"
echo " File: ${ARCHIVE} ($((ARCHIVE_KB / 1024)) MB)"
echo "========================================="
