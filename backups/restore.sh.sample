#!/bin/bash
#
# Restore Script for Powerwall Dashboard Data
#   https://github.com/jasonacox/Powerwall-Dashboard
#   by JonMurphy & Sam Cox
#
# Companion to backup.sh — restores InfluxDB snapshot, Grafana database,
# and configuration files from a backup archive created by that script.
# Safe for both same-machine restores and migrations to a new machine.

# Restore Powerwall-Dashboard Data
if [ "$EUID" -ne 0 ]; then
  echo "Must run as root"
  exit 1
fi

# ── Locate the Powerwall-Dashboard directory ──────────────────────────
# Resolve relative to this script's location (normally in backups/).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARENT_DIR="$(dirname "${SCRIPT_DIR}")"

if [ -f "${PARENT_DIR}/compose-dash.sh" ]; then
  DASHBOARD="${PARENT_DIR}"
else
  echo "ERROR: Could not locate Powerwall-Dashboard (no compose-dash.sh in ${PARENT_DIR})."
  echo "Run this script from your Powerwall-Dashboard/backups/ directory."
  exit 1
fi

BACKUP_FOLDER="${DASHBOARD}/backups"          # Location of backup archives

echo "Using Powerwall-Dashboard directory: ${DASHBOARD}"

if [ ! -d "${BACKUP_FOLDER}" ]; then
  echo "Backup directory ${BACKUP_FOLDER} does not exist."
  exit 1
fi

# ── Determine this host's correct owner:group for container files ─────
# Under sudo, SUDO_UID gives the invoking user (not root). Pair that with
# the docker GID so container files are owned by the real user + docker group.
# Falls back to id -u/id -g when not under sudo.
DOCKER_GID=$(getent group docker 2>/dev/null | cut -d: -f3)
HOST_UID="${SUDO_UID:-$(id -u)}"
HOST_GID="${SUDO_GID:-$(id -g)}"

# Guard: if we ended up with UID 0 (root shell via sudo -i / su -),
# container files would be owned by root instead of the real user.
# This breaks permission-sensitive containers (e.g. pypowerwall).
if [ "${HOST_UID}" -eq 0 ] 2>/dev/null; then
  echo "ERROR: Detected root as the owning user (UID 0)."
  echo "Run this script with 'sudo ./restore.sh' from your regular user account,"
  echo "not from a root shell ('sudo -i' or 'su -')."
  exit 1
fi

PWD_USER="${HOST_UID}:${DOCKER_GID:-${HOST_GID}}"
echo "Detected owner:group for this host: ${PWD_USER}"

# ── Determine which archive to restore ────────────────────────────────
# Usage: restore.sh [path-to-archive.tar.xz]
# If no archive is given, the most recent one in BACKUP_FOLDER is used.
if [ -n "$1" ]; then
  ARCHIVE="$1"
else
  ARCHIVE=$(ls -1t "${BACKUP_FOLDER}"/Powerwall-Dashboard.*.tar.xz 2>/dev/null | head -n 1)
fi

if [ -z "${ARCHIVE}" ] || [ ! -f "${ARCHIVE}" ]; then
  echo "No backup archive found."
  echo "Usage: $0 [path-to-Powerwall-Dashboard.YYYY-MM-DD.tar.xz]"
  exit 1
fi

STAMP=$(date '+%Y-%m-%d_%H%M%S')
STAGING=$(mktemp -d)
PRERESTORE_PATHS=()

# Cleanup staging on exit
cleanup() {
  rm -rf "${STAGING}"
}
trap cleanup EXIT

echo "========================================="
echo " Powerwall-Dashboard Restore - ${STAMP}"
echo "========================================="
echo "Archive: ${ARCHIVE}"
echo ""
read -r -p "This will OVERWRITE existing data. Continue? [y/N] " CONFIRM
if [[ ! "${CONFIRM}" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  echo "Restore cancelled."
  exit 0
fi

# ── Extract archive to staging ────────────────────────────────────────
# Reject archive members with path traversal entries before extracting
if tar -tf "${ARCHIVE}" | grep -qE '(^|/)\.\.(/|$)'; then
  echo "ERROR: Archive contains path traversal entries. Aborting."
  exit 1
fi
echo ""
echo "Extracting archive..."
if ! tar --no-same-owner -Jxvf "${ARCHIVE}" -C "${STAGING}" 2>&1; then
  echo "ERROR: Archive extraction failed. Aborting."
  exit 1
fi

# ── Stop the stack before touching data ───────────────────────────────
echo ""
echo "Stopping Powerwall-Dashboard containers..."
cd "${DASHBOARD}"
if ! ./compose-dash.sh stop; then
  echo "ERROR: Failed to stop containers. Aborting restore to prevent data corruption."
  exit 1
fi

# ── 1. InfluxDB Snapshot ──────────────────────────────────────────────
echo ""
echo "[1/3] Restoring InfluxDB snapshot..."
if [ -d "${STAGING}/influxdb" ] && [ -n "$(ls -A "${STAGING}/influxdb" 2>/dev/null)" ]; then
  mkdir -p influxdb/backups
  chmod g+w influxdb/backups
  rm -rf influxdb/backups/*
  cp -a "${STAGING}/influxdb/." influxdb/backups/

  # Move existing data aside (not deleted) so influxd restore has a clean target.
  # This provides a rollback path if the restore fails.
  for SUBDIR in data meta wal; do
    if [ -d "influxdb/${SUBDIR}" ]; then
      mv "influxdb/${SUBDIR}" "influxdb/${SUBDIR}.pre-restore.${STAMP}"
      echo "  - Existing influxdb/${SUBDIR} saved as influxdb/${SUBDIR}.pre-restore.${STAMP}"
      PRERESTORE_PATHS+=("${DASHBOARD}/influxdb/${SUBDIR}.pre-restore.${STAMP}")
    fi
  done

  # Start only influxdb so influxd restore has a running server to talk to
  ./compose-dash.sh up -d influxdb

  # Wait for InfluxDB to become healthy (up to 60 seconds)
  echo "  Waiting for InfluxDB to be ready..."
  for _ in $(seq 1 30); do
    HEALTH=$(docker inspect --format='{{.State.Health.Status}}' influxdb 2>/dev/null)
    if [ "${HEALTH}" = "healthy" ]; then
      break
    fi
    sleep 2
  done
  if [ "${HEALTH}" != "healthy" ]; then
    echo "  ⚠ InfluxDB not reporting healthy after 60s — attempting restore anyway..."
  fi

  if docker exec influxdb influxd restore -portable -db powerwall /var/lib/influxdb/backups; then
    echo "  ✓ InfluxDB snapshot restored"
  else
    echo "  ✗ InfluxDB restore command failed - check output above"
  fi

  # Re-create continuous queries after restore.
  # influxd restore -portable does not reliably restore CQs (known InfluxDB 1.x
  # limitation). The portable .meta file contains them, but the restore merge
  # into a live instance can drop them.
  #
  # Priority: use continuous_queries.txt from the backup archive (captures
  # live CQ state including user customizations) → fallback to influxdb.sql
  # (repo defaults) → skip with warning if neither exists.
  #
  # backup.sh exports clean CREATE statements (newer versions) or raw
  # SHOW CONTINUOUS QUERIES table output (older versions). Handle both.
  # Each statement must be terminated with ';' so the influx CLI can parse
  # multiple CREATE CONTINUOUS QUERY lines piped via stdin.
  CQ_RESTORED=0
  if [ -f "${STAGING}/influxdb/continuous_queries.txt" ] && grep -q 'CREATE CONTINUOUS QUERY' "${STAGING}/influxdb/continuous_queries.txt"; then
    # Extract just the CREATE statement from each line (handles both
    # clean format and raw table output with query_id prefix), append ';'.
    sed -n 's/.*\(CREATE CONTINUOUS QUERY.*\)/\1/p' "${STAGING}/influxdb/continuous_queries.txt" \
      | sed 's/$/;/' \
      | docker exec -i influxdb influx -database powerwall > /dev/null \
      && { echo "  ✓ Continuous queries re-created from backup (continuous_queries.txt)"; CQ_RESTORED=1; } \
      || echo "  ⚠ Failed to re-create continuous queries from continuous_queries.txt"
  fi
  if [ "${CQ_RESTORED}" -eq 0 ] && [ -f "${DASHBOARD}/influxdb/influxdb.sql" ]; then
    grep '^CREATE CONTINUOUS QUERY' "${DASHBOARD}/influxdb/influxdb.sql" \
      | sed 's/$/;/' \
      | docker exec -i influxdb influx -database powerwall > /dev/null \
      && echo "  ✓ Continuous queries re-created from influxdb.sql (repo defaults)" \
      || echo "  ⚠ Failed to re-create continuous queries — see influxdb/influxdb.sql"
  fi

  rm -rf influxdb/backups/*
else
  echo "  - No InfluxDB snapshot found in archive (skipping)"
fi

# ── 2. Grafana Database ───────────────────────────────────────────────
echo ""
echo "[2/3] Restoring Grafana database..."

GRAFANA_DB="${DASHBOARD}/grafana/grafana.db"
if [ -f "${STAGING}/grafana/grafana.db" ]; then
  mkdir -p "${DASHBOARD}/grafana"
  if [ -f "${GRAFANA_DB}" ]; then
    cp -a "${GRAFANA_DB}" "${GRAFANA_DB}.pre-restore.${STAMP}"
    echo "  - Existing grafana.db saved as grafana.db.pre-restore.${STAMP}"
    PRERESTORE_PATHS+=("${GRAFANA_DB}.pre-restore.${STAMP}")
  fi
  cp -a "${STAGING}/grafana/grafana.db" "${GRAFANA_DB}"
  chown "${PWD_USER}" "${GRAFANA_DB}"
  echo "  ✓ Grafana DB restored (owner set to ${PWD_USER})"
else
  echo "  - No grafana.db found in archive (skipping)"
fi

# Restore Grafana provisioning files if present
if [ -d "${STAGING}/grafana/provisions" ]; then
  # Save existing provisions before overwriting
  if [ -d "${DASHBOARD}/grafana/provisions" ]; then
    cp -a "${DASHBOARD}/grafana/provisions" "${DASHBOARD}/grafana/provisions.pre-restore.${STAMP}"
    PRERESTORE_PATHS+=("${DASHBOARD}/grafana/provisions.pre-restore.${STAMP}")
  fi
  cp -a "${STAGING}/grafana/provisions" "${DASHBOARD}/grafana/"
  chown -R "${PWD_USER}" "${DASHBOARD}/grafana/provisions"
  echo "  ✓ Grafana provisioning files restored (owner set to ${PWD_USER})"
fi

# ── 3. Configuration Files ────────────────────────────────────────────
echo ""
echo "[3/3] Restoring configuration files..."

# Git-tracked project files are archived for reference but must NOT be
# restored over the current checkout: restoring an older backup would
# silently downgrade powerwall.yml (container image tags), confuse
# upgrade.sh via a stale VERSION, and dirty the git tree causing future
# 'git pull' conflicts. Only user-owned config (*.env, telegraf.local,
# etc.) is restored.
GIT_TRACKED_SKIP=(
  "powerwall.yml"
  "telegraf.conf"
  "influxdb.conf"
  "VERSION"
  "_config.yml"
)

FOUND=0
SKIPPED=0
if [ -d "${STAGING}/config" ]; then
  # Use nullglob + include hidden files (.*.env) so dotfiles backed up by
  # backup.sh are also restored.
  shopt -s nullglob dotglob
  for FILE in "${STAGING}"/config/*; do
    [ -f "${FILE}" ] || continue
    BASENAME=$(basename "${FILE}")
    if [[ " ${GIT_TRACKED_SKIP[*]} " == *" ${BASENAME} "* ]]; then
      echo "  - Skipped ${BASENAME} (project file - managed by git, kept in archive for reference)"
      SKIPPED=$((SKIPPED + 1))
      continue
    fi
    if [ -f "${DASHBOARD}/${BASENAME}" ]; then
      cp -a "${DASHBOARD}/${BASENAME}" "${DASHBOARD}/${BASENAME}.pre-restore.${STAMP}"
      PRERESTORE_PATHS+=("${DASHBOARD}/${BASENAME}.pre-restore.${STAMP}")
    fi
    cp -a "${FILE}" "${DASHBOARD}/${BASENAME}"
    chown "${PWD_USER}" "${DASHBOARD}/${BASENAME}"

    # Rewrite PWD_USER in compose.env to match this host's actual user:group
    if [ "${BASENAME}" == "compose.env" ]; then
      grep -vE '^PWD_USER=' "${DASHBOARD}/${BASENAME}" > "${DASHBOARD}/${BASENAME}.tmp"
      echo "PWD_USER=\"${PWD_USER}\"" >> "${DASHBOARD}/${BASENAME}.tmp"
      mv "${DASHBOARD}/${BASENAME}.tmp" "${DASHBOARD}/${BASENAME}"
      chown "${PWD_USER}" "${DASHBOARD}/${BASENAME}"
      echo "  - Set PWD_USER=\"${PWD_USER}\" in compose.env (matches this host)"
    fi

    FOUND=$((FOUND + 1))
  done
fi
echo "  ✓ ${FOUND} config file(s) restored (owner set to ${PWD_USER})"
if [ "${SKIPPED}" -gt 0 ]; then
  echo "  - ${SKIPPED} project file(s) skipped (already provided by this checkout)"
fi

# ── Restart the stack ─────────────────────────────────────────────────
# Use 'up -d' (not 'start') so containers are RECREATED and pick up the
# restored env files (compose.env PWD_USER, pypowerwall.env, grafana.env,
# influxdb.env). 'docker compose start' would resume the old containers
# with their stale configuration baked in — and fails outright on a fresh
# machine where containers were never created.
echo ""
echo "Starting Powerwall-Dashboard containers..."
cd "${DASHBOARD}"
./compose-dash.sh up -d

echo ""
echo "========================================="
echo " Restore complete!"
echo " Restored from: ${ARCHIVE}"
if [ "${#PRERESTORE_PATHS[@]}" -gt 0 ]; then
  echo ""
  echo " Anything overwritten was saved first. Once you've confirmed"
  echo " the restore looks good, remove the pre-restore copies with:"
  echo ""
  for PATHNAME in "${PRERESTORE_PATHS[@]}"; do
    echo "   rm -rf \"${PATHNAME}\""
  done
fi
echo "========================================="
