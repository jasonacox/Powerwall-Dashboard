# Copy this file to dashboard-import.env and edit it.
# dashboard-import.env is local and is not committed.
# "default" keeps the value shipped in the stock dashboard.

# Stock file in the repo dashboards/ folder. default means dashboard.json.
DASHBOARD_FILE=default

# Legend position: default, bottom, or right.
LEGEND=default

# auto hides strings that /strings reports as disconnected.
# off leaves string queries alone. default means auto.
HIDE_STRINGS=auto

# Refresh interval: default, or one of Grafana's intervals
# 5s, 10s, 30s, 1m, 5m, 15m, 30m, 1h, 2h, 1d.
REFRESH=default

# Time range shown when the dashboard opens.
# default       leave the stock range
# today         the whole day, now/d to now/d
# today_so_far  now/d to now
# last_24h      now-24h to now
# last_7d       now-7d to now
TIME_RANGE=default
