# Copy this file to dashboard-import.env and edit it.
# dashboard-import.env is local and is not committed.
# "default" keeps the value shipped in the stock dashboard.

# Stock file in the repo dashboards/ folder. default means dashboard.json.
DASHBOARD_FILE=default

# Legend position: default, bottom, or right.
LEGEND=default

# auto hides strings whose Connected is false when at least one is true
# (JSON true or 1). If none are, string queries stay as they are.
# off leaves them alone. default means auto.
HIDE_STRINGS=auto

# default keeps the refresh interval already in the chosen dashboard file.
# Other values: 5s, 10s, 30s, 1m, 5m, 15m, 30m, 1h, 2h, 1d.
REFRESH=default

# Time range shown when the dashboard opens.
# default keeps the range already in the chosen file.
# today (Today, the whole day), today_so_far (Today so far),
# last_24h (Last 24 hours), last_7d (Last 7 days).
TIME_RANGE=default
