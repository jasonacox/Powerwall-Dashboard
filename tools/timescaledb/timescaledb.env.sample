# Environment variables for the TimescaleDB extension
#------------------------------------------------------------------------------#
# tools/timescaledb/setup.sh copies this to tools/timescaledb/timescaledb.env
# (gitignored), generates random POSTGRES_PASSWORD and GRAFANA_PG_PASSWORD
# values, and keeps TZ in sync with the stack's tz file each time it runs.
#
# Used by the timescaledb container itself and by every service that connects
# to it (telegraf-timescale, aggregate-cron, grafana). After editing, recreate
# them: ./compose-dash.sh up -d
#------------------------------------------------------------------------------#
POSTGRES_USER=telegraf_powerwall
POSTGRES_PASSWORD=changeme
POSTGRES_DB=powerwall

# Read-only user for Grafana. aggregate-cron creates it (or updates its
# password) on startup and grants it pg_read_all_data, so dashboard viewers
# can only read data, never change it.
GRAFANA_PG_USER=grafana_reader
GRAFANA_PG_PASSWORD=changeme

# Where TimescaleDB is reached from inside the compose network. Leave as-is
# for the bundled container. To use an existing server instead, see
# "Using an existing TimescaleDB server" in tools/timescaledb/README.md.
TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432

# libpq sslmode (disable, allow, prefer, require, verify-ca, verify-full).
# The bundled container doesn't use TLS, so keep "disable" for it.
TIMESCALEDB_SSLMODE=disable

# Timezone -- set from the stack's tz file by tools/timescaledb/setup.sh
TZ=America/Los_Angeles
