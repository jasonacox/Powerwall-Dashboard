# Powerwall-Dashboard TimescaleDB MCP server configuration.
#
# Copy this to mcp.env (repo root, alongside timescaledb.env) and fill in
# the values marked CHANGE_ME. mcp.env is gitignored, same as timescaledb.env.
#
# Deliberately a SEPARATE env file from timescaledb.env: this server should
# never see POSTGRES_USER/POSTGRES_PASSWORD (the stack's admin/write role).
# It connects as its own dedicated read-only role instead -- see
# readonly_role.sql.

# Same TimescaleDB server the rest of the stack uses. If you're running the
# bundled container, these match timescaledb.env's values; if you're using
# your own external server, use the same host/port you gave setup.sh.
TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432
POSTGRES_DB=powerwall
TIMESCALEDB_SSLMODE=disable

# The read-only role created by readonly_role.sql. Must match the password
# you set in that script's CREATE ROLE line.
MCP_DB_USER=mcp_readonly
MCP_DB_PASSWORD=CHANGE_ME

# MCP server's own listen address inside the container. Leave these as-is
# unless you're changing the published port mapping in powerwall.extend.yml
# instead (recommended -- see that file's comments).
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional bearer token. If set, every request to the MCP server must send
# `Authorization: Bearer <token>`. Strongly recommended if the published
# port is reachable from anywhere other than localhost -- this tool executes
# SQL against your real historical data. Leave blank to disable (fine for a
# port bound to 127.0.0.1 only, which is this file's default -- see
# powerwall.extend.yml.sample).
MCP_AUTH_TOKEN=

# Safety limits.
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_MS=30000
OVERVIEW_CACHE_TTL=300
